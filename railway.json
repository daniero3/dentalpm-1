{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["frontend/**"],
    "buildCommand": "cd frontend && npm install && npm run build",
    "nixpacksPlan": {
      "providers": ["node"]
    }
  },
  "deploy": {
    "startCommand": "cd frontend && npm run start",
    "healthcheckPath": "/"
  }
}
