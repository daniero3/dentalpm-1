{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["dental-pm-mvp/**"],
    "buildCommand": "cd dental-pm-mvp && npm install",
    "nixpacksPlan": {
      "providers": ["node"]
    }
  },
  "deploy": {
    "startCommand": "cd dental-pm-mvp && npm run start",
    "healthcheckPath": "/api/health"
  }
}
