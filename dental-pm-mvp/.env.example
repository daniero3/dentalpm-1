# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MVOLA_WEBHOOK_SECRET=
ORANGE_WEBHOOK_SECRET=
