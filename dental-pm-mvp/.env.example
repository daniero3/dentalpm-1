NODE_ENV=development
PORT=8001

# Database
DATABASE_URL=postgres://dental_admin:change-me@localhost:5432/dental_pm_madagascar
DB_SSL=false

# App
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
